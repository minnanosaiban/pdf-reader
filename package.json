{
  "name": "two-page-pdf-reader",
  "version": "0.1.0",
  "description": "連続2ページPDFリーダー",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler pages deploy dist --project-name pdf-reader"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/yomogi": "^5.3.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "private": "true"
}
